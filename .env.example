# Credenciais locais fictícias. Troque-as em qualquer ambiente compartilhado.
APP_CREDENTIALS_JSON={"demo-app":{"api_key":"demo-key-local-only","allowed_models":["mock-echo","mock-ops"],"requests_per_minute":30,"max_concurrency":2,"timeout_seconds":2.0}}

# mock (padrão) ou openai_compatible
LLM_PROVIDER=mock
PROVIDER_MAX_RETRIES=2

# Adapter opcional compatível com Chat Completions. Nunca é necessário no modo mock.
OPENAI_COMPATIBLE_BASE_URL=https://api.example.invalid/v1
OPENAI_COMPATIBLE_API_KEY=replace-with-a-real-secret-only-when-needed

# Preços opcionais em USD por milhão de tokens. O custo calculado é sempre uma estimativa.
MODEL_PRICING_JSON={}

# OpenTelemetry é desativado por padrão. Sem endpoint, exporta spans no console.
OTEL_ENABLED=false
OTEL_SERVICE_NAME=llm-operations-lab
OTEL_EXPORTER_OTLP_ENDPOINT=

# Langfuse é totalmente opcional e requer instalação do extra: uv sync --extra langfuse.
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# URL interna do mock SAP/OData. O adapter sempre usa este host fixo.
PURCHASE_ORDER_BASE_URL=http://127.0.0.1:8000/mock-sap/odata/v1
